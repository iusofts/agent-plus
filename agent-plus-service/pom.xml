<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.iusofts</groupId>
        <artifactId>agent-plus</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-plus-service</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.iusofts</groupId>
            <artifactId>agent-plus-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iusofts</groupId>
            <artifactId>agent-plus-id</artifactId>
        </dependency>
        <dependency>
            <groupId>com.iusofts</groupId>
            <artifactId>agent-plus-interface</artifactId>
        </dependency>
        <!-- 工作流引擎：提供 ChatModelProvider SPI 与 WorkflowEngine -->
        <dependency>
            <groupId>com.iusofts</groupId>
            <artifactId>agent-plus-engine</artifactId>
        </dependency>
        <!-- 插件模块：LLM/向量库/文档处理等三方集成 -->
        <dependency>
            <groupId>com.iusofts</groupId>
            <artifactId>agent-plus-plugin</artifactId>
        </dependency>
        <!-- 千问(DashScope)专用 ChatModel，用于按 ai_model 表路由 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-dashscope</artifactId>
        </dependency>
        <!-- OpenAI 兼容 Embedding(豆包/OpenAI 等按 ai_model 路由) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>
        <!-- Redis 向量库：RedisEmbeddingStore -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-redis</artifactId>
        </dependency>
        <!-- 文档解析：Apache Tika(全格式 txt/md/pdf/docx/xlsx/html...) -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
        </dependency>
        <!-- OSS 文档下载(OkHttp) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <!-- 阿里云 通义千问 官方SDK -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>dashscope-sdk-java</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
