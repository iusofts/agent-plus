        <result column="output_tokens" property="outputTokens" />
        <result column="total_tokens" property="totalTokens" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="org_id" property="orgId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, conversation_id, role, content, input_tokens, output_tokens, total_tokens, create_by, create_time, update_by, update_time, delete_flag, org_id
